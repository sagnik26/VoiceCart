# Copy to .env.local at this repo root. Never commit secrets.
# One file for the app, token mint, publish script, and Talk agent.

# LiveKit Cloud — server only. Do not prefix with EXPO_PUBLIC_.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# App (inlined into the bundle at Metro start). URL is public; secret stays above.
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# Android emulator → host loopback. Physical device → http://<LAN-IP>:8787/token
EXPO_PUBLIC_LIVEKIT_TOKEN_URL=http://10.0.2.2:8787/token
EXPO_PUBLIC_VOICE_USE_LIVE_METERING=true
# Optional smoke fallback (expires). Prefer TOKEN_URL.
# EXPO_PUBLIC_LIVEKIT_TOKEN=

# Talk agent (Python worker). Never EXPO_PUBLIC_.
SARVAM_API_KEY=
OPENAI_API_KEY=
