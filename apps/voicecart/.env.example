# LiveKit Cloud (Phase 1). Copy to .env.local and fill in. Never commit secrets.

# Server-only — used by `npm run token:livekit`. Do not prefix with EXPO_PUBLIC_.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# App — URL is public; mint endpoint is your machine, not the API secret.
EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# Android emulator → host loopback. Physical device → http://<LAN-IP>:8787/token
EXPO_PUBLIC_LIVEKIT_TOKEN_URL=http://10.0.2.2:8787/token
EXPO_PUBLIC_VOICE_USE_LIVE_METERING=true

# Optional smoke fallback (expires). Prefer TOKEN_URL so the secret stays on the mint server.
# EXPO_PUBLIC_LIVEKIT_TOKEN=
