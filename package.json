{
  "name": "voicecart-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "apps/*/features/*",
    "apps/*/core/*",
    "core/modules/*",
    "services/*"
  ],
  "scripts": {
    "start": "npm run start -w voicecart",
    "android": "npm run android -w voicecart",
    "ios": "npm run ios -w voicecart",
    "web": "npm run web -w voicecart",
    "lint": "npm run lint -w voicecart",
    "type:check": "npm run type:check -w voicecart",
    "token:livekit": "npm run token:livekit -w voicecart",
    "publish:livekit-audio": "npm run publish:livekit-audio -w voicecart",
    "agent": "npm run dev -w @voicecart/talk-agent",
    "agent:setup": "npm run setup -w @voicecart/talk-agent"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "expo": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.0"
  }
}
