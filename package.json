{
  "name": "voicecart-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "apps/*/features/*",
    "apps/*/core/*",
    "core/modules/*"
  ],
  "scripts": {
    "start": "npm run start -w voicecart",
    "android": "npm run android -w voicecart",
    "ios": "npm run ios -w voicecart",
    "web": "npm run web -w voicecart",
    "lint": "npm run lint -w voicecart",
    "type:check": "npm run type:check -w voicecart"
  },
  "engines": {
    "node": ">=20"
  }
}
